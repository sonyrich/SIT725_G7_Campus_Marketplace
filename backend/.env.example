# Server port. macOS AirPlay Receiver uses 5000 by default — if you hit
# EADDRINUSE, either disable AirPlay Receiver in System Settings or just
# change this value. server.js already falls back to 3000 if unset.
PORT=3000

# Local MongoDB (Docker container or local install) — ?retryWrites=true&w=majority
# only apply to replica sets (e.g. Atlas), so they're omitted here.
MONGO_URI=mongodb://localhost:27017/campus-marketplace

# If backend runs in the same docker-compose network as MongoDB,
# replace "localhost" with your Mongo service name, e.g.
# MONGO_URI=mongodb://mongo:27017/campus-marketplace

# JWT signing secret. Generate a random one — never commit a real value.
# Quick generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_generated_secret