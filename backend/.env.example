# Copy this file to .env (same folder) and adjust if needed:
#   macOS / Linux:  cp .env.example .env
#   Windows (cmd):  copy .env.example .env
# Every value below has a working default, so the app still starts without
# a .env file — but set JWT_SECRET so logins survive a server restart.

# Port the web server listens on (http://localhost:3000).
# macOS AirPlay Receiver uses 5000, so avoid that one.
PORT=3000

# Local MongoDB (installed locally or started with `docker compose up -d mongo`).
# 127.0.0.1 is used instead of "localhost" to avoid IPv6 (::1) issues on newer Node.
# For MongoDB Atlas, paste your Atlas connection string here instead.
MONGO_URI=mongodb://127.0.0.1:27017/campus-marketplace

# JWT signing secret. Generate your own — never commit a real value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_generated_secret

# How long a login lasts (e.g. 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
